---
import { useTranslations, localizedPath } from "../i18n/utils";
import type { Locale } from "../i18n/ui";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";

interface Props {
  locale: Locale;
  altPath: string;
}
const { locale, altPath } = Astro.props;
const t = useTranslations(locale);

/* The site is one page: these are anchors into it, not routes. They stay
   absolute rather than bare "#work" so they also work from the case-study
   pages, which are the only routes left besides home. */
const home = localizedPath(locale, "/");
/* Home is an anchor too. Pointing it at bare "/" made it the one link that
   reloaded the page instead of scrolling — no smooth scroll, no snap. */
const section = (id: string) => `${home}#${id}`;

/* One list, rendered twice: inline from md up, and inside the phone menu below
   that. Five labels plus the two toggles don't fit a 360–375px bar (English ran
   59px over), so phones get a menu instead of a squeezed or scrolling row. */
const links = [
  { id: "top", label: t("nav.home") },
  { id: "work", label: t("nav.work") },
  { id: "experience", label: t("nav.experience") },
  { id: "about", label: t("nav.about") },
  { id: "contact", label: t("nav.contact") },
];
---

{/* Sticky, because the home page is one full screen per section: in flow this
    bar would scroll away after the first screen and take the whole nav with it.
    The opaque background is load-bearing too — the background field is fixed to
    the viewport and reaches up behind this bar, so a transparent header would
    have dots and section text sliding through the nav. */}
<header class="sticky top-0 z-20 border-b border-[var(--border)] bg-[var(--bg)]">
  <div class="relative max-w-4xl mx-auto px-5 h-16 flex items-center justify-between md:justify-end gap-3">
    {/* Absolutely centred from md up so the links sit on the page's true centre
        regardless of how wide the toggles are — `left` is deliberate and not
        `start`: centring is symmetric, so the logical property would flip it
        off-centre in RTL. */}
    <nav
      class="hidden md:flex items-center gap-7 text-base font-medium text-[var(--text-muted)] absolute left-1/2 -translate-x-1/2"
    >
      {links.map((link) => (
        <a href={section(link.id)} class="hover:text-[var(--text)] transition-colors">
          {link.label}
        </a>
      ))}
    </nav>

    {/* Phones: a native <details> disclosure — open/close, keyboard and screen
        reader semantics come with the element. The script below only closes it
        on a pick, an outside click, or Escape. The panel hangs off the
        `relative` bar, full width, on the same opaque background. */}
    <details class="site-menu md:hidden">
      <summary
        class="list-none [&::-webkit-details-marker]:hidden cursor-pointer select-none inline-flex items-center gap-2 h-9 px-3 rounded-md border border-[var(--border)] text-sm font-medium text-[var(--text-muted)] hover:text-[var(--text)] transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        {t("nav.menu")}
      </summary>
      <nav class="absolute inset-x-0 top-full border-b border-[var(--border)] bg-[var(--bg)] px-5 py-2 flex flex-col">
        {links.map((link) => (
          <a
            href={section(link.id)}
            class="py-3 text-base font-medium text-[var(--text-muted)] hover:text-[var(--text)] transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </details>
    <div class="flex items-center gap-2">
      <LanguageToggle locale={locale} targetPath={altPath} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<script is:inline>
  /* A smooth anchor jump under `scroll-snap-type: y mandatory` bounces back to
     the section it started from on phones: the browser still holds the old
     section as its snap target, and the toolbar collapsing mid-scroll resizes
     the viewport, which makes it re-snap to that target. So for anchors into
     this page, snapping is switched off for the jump and handed back once the
     scroll has settled — at which point the nearest snap point is the target
     itself, so nothing moves. Links to another page are left to the browser. */
  (function () {
    const root = document.documentElement;
    const here = location.pathname.replace(/\/$/, "");
    let settle;

    function release() {
      root.style.scrollSnapType = "";
      window.removeEventListener("scroll", onScroll);
    }

    function waitForQuiet(ms) {
      clearTimeout(settle);
      settle = setTimeout(release, ms);
    }

    function onScroll() {
      waitForQuiet(150);
    }

    function holdSnap() {
      root.style.scrollSnapType = "none";
      window.addEventListener("scroll", onScroll, { passive: true });
      // Longer before the first scroll event: a janky first frame (the dot
      // field is a shader) must not hand snapping back before the jump starts.
      waitForQuiet(400);
    }

    const menu = document.querySelector("header .site-menu");

    document.querySelectorAll("header nav a[href*='#']").forEach((link) => {
      link.addEventListener("click", (event) => {
        // A pick from the phone menu folds it away first, so the jump lands
        // on an uncovered section and a cross-page link doesn't leave it open
        // in the back/forward cache.
        if (menu) menu.open = false;
        const url = new URL(link.href);
        if (url.pathname.replace(/\/$/, "") !== here) return;
        const target = document.getElementById(url.hash.slice(1));
        if (!target) return;

        event.preventDefault();
        holdSnap();
        // No options, so it follows the CSS scroll-behavior: smooth normally,
        // instant under prefers-reduced-motion.
        target.scrollIntoView();
        if (location.hash !== url.hash) history.pushState(null, "", url.hash);
      });
    });

    /* Arriving with a hash — from the language toggle, or a nav link on a
       case-study page — the browser's own load-time jump is smooth as well, and
       starts from the top section, so it can bounce back the same way. Land on
       the section instantly instead, with snapping held off until it settles. */
    function landOnHash() {
      const target = location.hash && document.getElementById(location.hash.slice(1));
      if (!target || target.tagName !== "SECTION") return;
      holdSnap();
      target.scrollIntoView({ behavior: "instant" });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", landOnHash, { once: true });
    } else {
      landOnHash();
    }

    // <details> opens and closes itself; what it doesn't do is close when the
    // reader clicks elsewhere or presses Escape, which a menu is expected to.
    if (menu) {
      document.addEventListener("click", (event) => {
        if (menu.open && !menu.contains(event.target)) menu.open = false;
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !menu.open) return;
        menu.open = false;
        menu.querySelector("summary").focus();
      });
    }
  })();
</script>
