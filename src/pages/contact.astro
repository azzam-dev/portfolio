---
import Base from "../layouts/Base.astro";
import { useTranslations } from "../i18n/utils";

const locale = "en" as const;
const t = useTranslations(locale);
const email = "azzamalfahad23@gmail.com";
---

<Base locale={locale} title="Contact — Azzam" description={t("contact.line")}>
  <section class="max-w-2xl mx-auto px-5 py-20">
    <h1 class="text-2xl font-semibold mb-6">{t("contact.heading")}</h1>
    <p class="text-[var(--text-muted)] mb-8">{t("contact.line")}</p>
    <a
      href={`mailto:${email}`}
      class="mono inline-block text-lg text-[var(--accent)] underline underline-offset-4"
    >
      {email}
    </a>
  </section>
</Base>
