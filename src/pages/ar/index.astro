---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import DotLensBackground from "../../components/DotLensBackground";
import ProjectCard from "../../components/ProjectCard.astro";
import FeaturedProject from "../../components/FeaturedProject.astro";
import { useTranslations } from "../../i18n/utils";

const locale = "ar" as const;
const t = useTranslations(locale);
const projects = await getCollection("projects", (entry) => entry.id.startsWith("ar/"));
const email = "azzamalfahad23@gmail.com";
const [featured, ...rest] = projects;

/* Taken from the skills section of the CV plus what the projects here actually
   ship — not a wish list. Keep the two in step when either changes. */
const tools = [
  "Python",
  "C++",
  "TypeScript",
  "SQL",
  "PyQt",
  "OpenCV",
  "Next.js",
  "PostgreSQL",
];

const linkedinUrl = "https://www.linkedin.com/in/azzam-alfahad";
/* Shown without the "www." — it is 4 characters of nothing, and the value
   column is the tightest thing on a 375px screen. */
const linkedinLabel = "linkedin.com/in/azzam-alfahad";

/* One screen per section. min-h-svh rather than h-svh so a section that
   outgrows the viewport keeps scrolling instead of clipping, and svh rather
   than vh so mobile browser chrome doesn't push the bottom out of reach.
   pb-6 on phones because Work only fits a 375×701 screen with it; pt stays at
   20 since the sticky header covers the top 65px of every section. */
const panel =
  "min-h-svh flex flex-col justify-center snap-start snap-always px-5 pt-20 pb-6 md:pt-24 md:pb-16";
---

<Base
  locale={locale}
  title="عزام الفهد — أبني أشياء معقّدة بتجارب بسيطة."
  description={t("home.subline")}
>
  {/* One page. The header's Work/About/Contact links are anchors into the
      sections below, not routes. `isolate` gives the field's negative z-index a
      context of its own, so it lands above the page background instead of
      behind it. Nothing here needs pointer-events juggling: the field reads the
      pointer off the window, so the page stays ordinarily clickable on top.

      The section labels drop the `mono uppercase tracking-widest` treatment the
      English page uses: letter-spacing breaks the joins between Arabic letters
      (مشاريعي renders as مـشا ريـعي), and JetBrains Mono has no Arabic glyphs
      to set it in anyway. */}
  <div class="relative isolate">
    <DotLensBackground client:visible />

    <section id="top" class={panel}>
      <div class="max-w-4xl mx-auto w-full">
        <h1 class="t-display mb-5">
          {t("home.name")}
        </h1>
        <p class="t-lead mb-4 max-w-2xl">
          {t("home.tagline")}
        </p>
        <p class="t-body text-[var(--text-muted)] max-w-2xl">
          {t("home.subline")}
        </p>

        {/* download + type so the browser saves it rather than opening a
            viewer tab, and the filename is the one people end up with. */}
        <a
          href="/Azzam-Alfahad-CV.pdf"
          class="btn-accent btn-download mt-9"
          download="Azzam-Alfahad-CV.pdf"
          type="application/pdf"
        >
          {t("home.cv")}
          <span aria-hidden="true">&darr;</span>
        </a>
      </div>
    </section>

    <section id="work" class={panel}>
      <div class="max-w-4xl mx-auto w-full">
        <p class="eyebrow mb-3">01 / {t("nav.work")}</p>
        <h2 class="t-h2 mb-5 md:mb-7">
          {t("home.workHeading")}
        </h2>
        {featured && <FeaturedProject locale={locale} project={featured} />}
        {rest.length > 0 && (
          <div class="grid md:grid-cols-2 gap-4 mt-10">
            {rest.map((project) => <ProjectCard locale={locale} project={project} />)}
          </div>
        )}
      </div>
    </section>

    <section id="about" class={panel}>
      <div class="max-w-4xl mx-auto w-full">
        <p class="eyebrow mb-3">02 / {t("nav.about")}</p>
        <h2 class="t-h2 mb-5 md:mb-7">
          {t("about.heading")}
        </h2>
        {/* The second paragraph is sm-and-up only: with it, About is 900px tall
            on a 375px phone and overflows a snapped screen by ~200px. Without
            it, the lead takes the larger gap so the tools list keeps its air. */}
        <p class="t-lead max-w-2xl mb-8 sm:mb-6">
          خرّيج علوم حاسب من جامعة المجمعة. قضيت فترة تدريب تعاوني مهندسَ برمجيات
          متدرّبًا في المركز الوطني للذكاء الاصطناعي (سدايا) بالرياض، حيث بنيت أداة
          داخلية خفّفت الاحتكاك في سير عمل الفريق اليومي.
        </p>
        <p class="hidden sm:block t-body text-[var(--text-muted)] max-w-2xl mb-8">
          ما أعود إليه دائمًا هو الحدّ الذي يدافع عنه النظام: المصادقة، والتحكّم في
          الوصول، والنقطة التي يقرّر عندها التصميم ما الذي يُسمح له بمعرفته. بدأ ذلك
          بخزنة ملفات على سطح المكتب بـPython وPyQt تجمع كلمة المرور مع التعرّف على
          الوجه، واستمرّ في إعادة الكتابة للويب التي حلّت محلّها، حيث وجب إعادة تثبيت
          كل تلك القواعد في متصفح لا يثق بشيء.
        </p>
        <p class="eyebrow mb-4">{t("about.workWith")}</p>
        <ul class="flex flex-wrap gap-2">
          {tools.map((tool) => <li class="chip" dir="ltr">{tool}</li>)}
        </ul>
      </div>
    </section>

    <section id="contact" class={panel}>
      <div class="max-w-4xl mx-auto w-full">
        <p class="eyebrow mb-3">03 / {t("nav.contact")}</p>
        <h2 class="t-h2 mb-6">
          {t("contact.heading")}
        </h2>
        <p class="t-lead text-[var(--text-muted)] mb-9 max-w-2xl">
          {t("contact.line")}
        </p>
        {/* <dl> because these are term/value pairs. Each row is a whole target
            rather than a bare underline, so there is something to aim at on a
            screen this empty. */}
        <dl class="space-y-3 max-w-xl">
          <div>
            <a href={`mailto:${email}`} class="link-row">
              <dt class="t-body text-[var(--text-muted)]">{t("contact.email")}</dt>
              <dd class="mono text-sm sm:text-base text-[var(--accent)] break-all" dir="ltr">{email}</dd>
            </a>
          </div>
          <div>
            <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="link-row">
              <dt class="t-body text-[var(--text-muted)]">{t("contact.linkedin")}</dt>
              <dd class="mono text-sm sm:text-base text-[var(--accent)] break-all" dir="ltr">
                {linkedinLabel}<span aria-hidden="true"> ↗</span>
              </dd>
            </a>
          </div>
        </dl>
      </div>
    </section>
  </div>
</Base>

{/* Scoped to this page on purpose: the scroll container is the document, but
    only the home page has snap sections. Astro ships a page's styles with that
    page alone, so the case-study routes keep ordinary scrolling. */}
<style is:global>
  html {
    scroll-snap-type: y mandatory;
  }
  /* Snapping fights the user when a section is taller than the screen, which is
     what a short window does. Below that, scroll normally. */
  @media (max-height: 700px) {
    html {
      scroll-snap-type: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-snap-type: none;
    }
  }
</style>
